<?xml version="1.0" encoding="UTF-8"?>
<addons>
  <addon id="One.repo" version="1.15" name="[B][COLOR white]Repositorio[/COLOR]: [COLOR aquamarine]ONE[/COLOR][COLOR white]PLAY[/COLOR][/B]" provider-name="TEAM [COLOR aquamarine]ONE[/COLOR][COLOR white]PLAY[/COLOR]">
    <requires>
      <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="OnePlay Repositorio">
      <dir>
        <info compressed="false">https://raw.githubusercontent.com/oneplayhd/oneplayhd.github.io/master/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/oneplayhd/oneplayhd.github.io/master/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/oneplayhd/oneplayhd.github.io/master/</datadir>
        <hashes>false</hashes>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <summary lang="pt_br">[COLOR white]••• Repositorio Oficial •••[/COLOR]</summary>
      <description lang="pt_br">[COLOR aquamarine]ONE[/COLOR]REPO é um agregador de addons. Assim como o Google.com, o OnePlay atua exclusivamente como um indexador e organizador de links de conteúdos disponibilizados publicamente na internet.</description>
      <disclaimer lang="pt_br">[COLOR aquamarine]O plugin atua unicamente como um agregador de links. Não hospedamos, transmitimos ou reproduzimos qualquer conteúdo de mídia. A responsabilidade pelo conteúdo acessado é exclusiva do respectivo provedor ou fonte original.[/COLOR]</disclaimer>
      <news>
• Adaptação das informações de acordo com a versão atual do Kodi.
• Adição de capturas de tela em "resources" para visualização prévia.
• Atualização dos links de apontamento para o GitHub.
• O repositório oferecerá suporte apenas para as versões mais recentes.
• Atualizado os links de apontamento para raw.usercontent
• Atualização em: 18/12/2025
		</news>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
        <screenshot>resources/screenshot-1.jpg</screenshot>
        <screenshot>resources/screenshot-2.jpg</screenshot>
        <screenshot>resources/screenshot-3.jpg</screenshot>
      </assets>
    </extension>
  </addon>
  <addon id="plugin.audio.estudioKazaFM" version="3.0.2" name="Estúdio KAZA FM" provider-name="TEAM Estúdio KAZA FM">
    <requires>
      <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
      <provides>audio</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="pt">Estúdio KAZA FM</summary>
      <description lang="en_GB">BANDEIRANTES-PR</description>
      <disclaimer lang="en_GB">No warranty</disclaimer>
      <assets>
        <icon>resources/images/icon.png</icon>
        <fanart>resources/images/fanart.jpg</fanart>
      </assets>
      <news>3.0.2 - Estudio ao vivo, Streams adicionais adicionados</news>
    </extension>
  </addon>
  <addon id="plugin.video.faustinotv" name="[B][COLOR cyan]FaustinoTV[/COLOR][/B]" version="3.1.1" provider-name="faustinotv">
    <requires>
      <import addon="xbmc.python" version="3.0.0"/>
      <import addon="script.module.requests"/>
      <import addon="inputstream.adaptive"/>
      <import addon="script.module.simplejson"/>
      <import addon="script.module.kodi-six"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="faustinotv.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en">TV AO VIVO | FILMES | SERIES</summary>
      <description lang="en">PLUGIN OFICIAL FAUSTINOTV</description>
      <platform>all</platform>
      <assets>
